{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Excel Desktop (Edge Chromium)",
      "type": "msedge",
      "request": "attach",
      "useWebView": true,
      "port": 9222,
      "timeout": 300000,
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Excel Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "https://office.live.com/start/Excel.aspx",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Taskpane Direct Browser Preview",
      "type": "chrome",
      "request": "launch",
      "url": "https://localhost:3000/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
